#include <windows.h>
#include "resource.h"

#ifndef IDC_STATIC
#define IDC_STATIC -1
#endif

IDD_SETTINGS_DLG DIALOGEX 0, 0, 320, 170
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "NppTranslate - Settings"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Provider:",IDC_STATIC_PROVIDER,12,14,50,10
    COMBOBOX        IDC_PROVIDER,70,12,230,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Source language:",IDC_STATIC_SOURCE,12,38,60,10
    EDITTEXT        IDC_SOURCE_LANG,80,36,70,14,ES_AUTOHSCROLL
    LTEXT           "Target language:",IDC_STATIC_TARGET,160,38,70,10
    EDITTEXT        IDC_TARGET_LANG,235,36,65,14,ES_AUTOHSCROLL
    LTEXT           "DeepL API key:",IDC_STATIC_DEEPL_KEY,12,64,70,10
    EDITTEXT        IDC_DEEPL_KEY,80,62,220,14,ES_AUTOHSCROLL | ES_PASSWORD
    LTEXT           "DeepL endpoint:",IDC_STATIC_DEEPL_EP,12,90,70,10
    COMBOBOX        IDC_DEEPL_ENDPOINT,80,88,220,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Language codes: auto, it, en, de, fr, es, ...",IDC_STATIC_LANG_HINT,12,118,280,10
    DEFPUSHBUTTON   "OK",IDOK,168,140,60,18
    PUSHBUTTON      "Cancel",IDCANCEL,240,140,60,18
END

IDD_PREVIEW_DLG DIALOGEX 0, 0, 500, 300
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "NppTranslate - Preview"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Phrases:",IDC_STATIC_PHRASES,12,10,120,10
    LISTBOX         IDC_PREVIEW_LIST,12,22,150,240,LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT           "Original:",IDC_STATIC_ORIGINAL,175,10,200,10
    EDITTEXT        IDC_PREVIEW_ORIGINAL,175,22,310,90,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT           "Translated (editable):",IDC_STATIC_TRANSLATED,175,122,200,10
    EDITTEXT        IDC_PREVIEW_TRANSLATED,175,134,310,128,ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    DEFPUSHBUTTON   "Apply",IDC_BTN_APPLY,345,272,65,18
    PUSHBUTTON      "Cancel",IDC_BTN_CANCEL,420,272,65,18
END

IDD_ABOUT_DLG DIALOGEX 0, 0, 300, 150
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "NppTranslate - About"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    EDITTEXT        IDC_ABOUT_TEXT,12,12,276,105,ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_BORDER
    DEFPUSHBUTTON   "OK",IDOK,120,124,60,18
END
